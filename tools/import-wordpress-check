#!/usr/bin/env python3
"""Focused offline safety/ownership checks, plus an optional generated-corpus check."""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import re
import tempfile
import tomllib
import unittest

loader = importlib.machinery.SourceFileLoader('wpimport', str(Path(__file__).with_name('import-wordpress')))
spec = importlib.util.spec_from_loader(loader.name, loader)
wp = importlib.util.module_from_spec(spec)
loader.exec_module(wp)


class Safety(unittest.TestCase):
    def clean(self, source, article=False):
        p = wp.Sanitizer(article=article)
        p.feed(source)
        return p.result()

    def test_active_content_and_schemes(self):
        output = self.clean('<p onclick="bad()">Visible<script>hidden</script><a href="java&#x0a;script:bad()">link</a><img src="x" onerror="bad()"></p>')
        self.assertEqual(output, '<p>Visible<a>link</a><img src="x"></p>')

    def test_provider_boundary_and_comments(self):
        source = '<iframe src="http://www.youtube.com/embed/example" allow="autoplay"></iframe>'
        output = self.clean(source, article=True)
        self.assertIn('src="https://www.youtube.com/embed/example"', output)
        self.assertNotIn('autoplay', output)
        self.assertEqual(self.clean(source), '')
        self.assertEqual(self.clean('<iframe src="https://unapproved.example/embed"></iframe>', True), '')
        self.assertIsNone(wp.safe_url('https://name:secret@www.youtube.com/embed/x', iframe=True))

    def test_code_entities_and_more(self):
        source = '<pre><code>if (x &lt; y) {\n  f(&amp;value);\n}</code></pre><!--more--><span id="more-1"></span>'
        self.assertEqual(self.clean(source, article=True), source)

    def test_manual_and_english_preservation(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            english = root / 'content/posts/2026-01-01-example/index.en.html'
            english.parent.mkdir(parents=True)
            english.write_text('Reviewed English stays untouched')
            files = {'content/posts/2026-01-01-example/index.cs.html': b'Generated Czech'}
            wp.write_output(files, root)
            self.assertEqual(english.read_text(), 'Reviewed English stays untouched')
            wp.write_output(files, root)
            (root / 'content/posts/2026-01-01-example/index.cs.html').write_text('Manual correction')
            with self.assertRaisesRegex(ValueError, 'manual edit'):
                wp.write_output(files, root)

    def assignment(self):
        return {'articles': [{'article_id': 'wp-1', 'legacy_post_id': 1,
                              'cs_file': 'content/posts/2026-01-01-original-title/index.cs.html'}]}

    def article(self, ident, text):
        return ('+++\ntranslationKey="' + ident + '"\n[params]\narticle_id="'
                + ident + '"\n+++\n' + text + '\n').encode()

    def projection(self):
        manifest = self.assignment()
        name = wp.article_paths(manifest)['wp-1']
        content = self.article('wp-1', 'Generated Czech')
        manifest['generated_files'] = {name: wp.digest(content)}
        return {name: content, 'data/migration/source-manifest.json': wp.encoded(manifest)}

    def test_mapped_location_fresh_repeat_and_english_ownership(self):
        files = self.projection()
        name = wp.article_paths(self.assignment())['wp-1']
        with tempfile.TemporaryDirectory() as directory:
            root, fresh = Path(directory) / 'in-place', Path(directory) / 'fresh'
            wp.write_output(files, root)
            english = (root / name).with_name('index.en.html')
            english.write_bytes(self.article('wp-1', 'English remains unchanged\r\n'))
            english_bytes = english.read_bytes()
            wp.write_output(files, root)
            wp.write_output(files, fresh)
            self.assertEqual((root / name).read_bytes(), (fresh / name).read_bytes())
            self.assertFalse((root / 'content/posts/wp-1').exists())
            self.assertEqual(english.read_bytes(), english_bytes)
            (root / name).write_bytes(files[name] + b'Manual Czech change')
            with self.assertRaisesRegex(ValueError, 'manual edit'):
                wp.write_output(files, root)
            self.assertEqual(english.read_bytes(), english_bytes)

    def test_invalid_duplicate_and_unknown_assignments(self):
        for path in ('/tmp/index.cs.html', '../index.cs.html',
                     'content/posts/../2026-01-01-example/index.cs.html',
                     'content/posts/2026-02-30-example/index.cs.html',
                     'content/posts/2026-01-01-example/index.en.html',
                     'content/posts/wp-1/index.cs.html'):
            manifest = self.assignment()
            manifest['articles'][0]['cs_file'] = path
            with self.subTest(path=path), self.assertRaisesRegex(ValueError, 'Invalid'):
                wp.article_paths(manifest)
        for same_id in (True, False):
            manifest = self.assignment()
            duplicate = dict(manifest['articles'][0])
            if not same_id:
                duplicate.update(article_id='wp-2', legacy_post_id=2)
            manifest['articles'].append(duplicate)
            with self.assertRaisesRegex(ValueError, 'Duplicate'):
                wp.article_paths(manifest)
        manifest = self.assignment()
        manifest['articles'][0]['legacy_post_id'] = 2
        with self.assertRaisesRegex(ValueError, 'Invalid'):
            wp.article_paths(manifest)
        with self.assertRaisesRegex(ValueError, 'Unknown article ID'):
            wp.project({'post': [{'id': 9999}]}, None, None, source_manifest=self.assignment())

    def test_existing_bundle_identity_refusal_before_writes(self):
        files = self.projection()
        name = wp.article_paths(self.assignment())['wp-1']
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            english = (root / name).with_name('index.en.html')
            english.parent.mkdir(parents=True)
            english.write_bytes(self.article('wp-2', 'Another article'))
            with self.assertRaisesRegex(ValueError, 'another article bundle'):
                wp.write_output(files, root)
            self.assertFalse((root / name).exists())
            self.assertEqual(english.read_bytes(), self.article('wp-2', 'Another article'))

    def test_private_query_field_exclusions(self):
        for field in ('user_pass', 'user_email', 'user_login', 'comment_author_email',
                      'comment_author_IP', 'comment_agent', 'user_activation_key'):
            self.assertNotIn(field, wp.SQL)


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        assert key not in result, 'Duplicate JSON metadata key'
        result[key] = value
    return result


def original_shared_projection(name, value, manifest):
    """Hash only original shared rows; appended authored rows do not bless edits."""
    def selected(mapping, names):
        assert len(names) == len(set(names)), 'Duplicate original metadata selector'
        assert all(name in mapping for name in names), 'Missing original shared metadata row'
        return {name: mapping[name] for name in names}
    if name == 'data/articles.json':
        result = selected(value, [row['article_id'] for row in manifest['articles']])
    elif name == 'data/authors.json':
        slugs = [path.strip('/').split('/')[1] for path in manifest['archives']['authors']]
        ids = []
        for slug in slugs:
            matches = [key for key, row in value.items() if row.get('slug') == slug]
            assert len(matches) == 1, 'Missing or ambiguous original author slug'
            ids.append(matches[0])
        result = selected(value, ids)
    elif name == 'data/taxonomies.json':
        result = {kind: selected(value[kind], [path.strip('/').split('/')[1]
                  for path in manifest['archives'][kind]]) for kind in ('categories', 'tags')}
    else:
        raise ValueError('Not shared generated metadata')
    return wp.encoded(result)


def check_corpus(root, private_posts=None):
    manifest = json.loads((root / 'data/migration/source-manifest.json').read_text())
    wp.article_paths(manifest)
    assert manifest['counts'] == {'articles': 125, 'authors': 6, 'comments': 107,
                                  'comment_replies': 43, 'uploads': 569,
                                  'upload_bytes': 50375369, 'attachments': 144}
    banned = {'user_pass', 'user_email', 'user_login', 'comment_author_email',
              'comment_author_IP', 'comment_agent', 'user_activation_key', 'roles'}

    def keys(value):
        if isinstance(value, dict):
            assert not banned.intersection(value), 'Private field in public JSON'
            for item in value.values():
                keys(item)
        elif isinstance(value, list):
            for item in value:
                keys(item)

    for name, expected in manifest['generated_files'].items():
        content = (root / name).read_bytes()
        if name in ('data/articles.json', 'data/authors.json', 'data/taxonomies.json'):
            content = original_shared_projection(name, json.loads(content, object_pairs_hook=unique_object), manifest)
        assert hashlib.sha256(content).hexdigest() == expected, name
        assert not name.endswith('index.en.html')
        if name.endswith('.json'):
            keys(json.loads((root / name).read_text()))
    raw = {p['id']: p for p in json.loads(private_posts.read_text())} if private_posts else None
    comment_count = replies = 0
    seen_paths = set()
    for article in manifest['articles']:
        # Preserve original preformatted CRLF bytes for complete-file hashing.
        content = (root / article['cs_file']).read_bytes().decode('utf-8')
        assert content.startswith('+++\n')
        _, frontmatter, body = content.split('+++', 2)
        fm = tomllib.loads(frontmatter)
        assert article['cs_path'] == fm['url'] and fm['url'] not in seen_paths
        seen_paths.add(fm['url'])
        assert fm['params']['article_id'] == fm['translationKey'] == article['article_id']
        assert fm['params']['source_body_sha256'] == article['source_body_sha256']
        assert hashlib.sha256(content.encode()).hexdigest() == article['cs_file_sha256']
        assert '<!--more-->' in body and 'id="more-' + str(article['legacy_post_id']) + '"' in body
        assert not re.search(r'<script\b|\son\w+\s*=', body, re.I)
        if raw:
            original = raw[article['legacy_post_id']]['body']
            assert hashlib.sha256(original.encode()).hexdigest() == article['source_body_sha256']
            a, b = wp.VisibleText(), wp.VisibleText()
            a.feed(original)
            b.feed(body)
            assert re.sub(r'\s+', ' ', ''.join(a.parts)).strip() == re.sub(r'\s+', ' ', ''.join(b.parts)).strip(), article['article_id']
        comments = json.loads((root / 'data/legacy-comments' / (article['article_id'] + '.json')).read_text())
        assert comments == sorted(comments, key=lambda c: (c['date'], c['id']))
        ids = {c['id'] for c in comments}
        by_id = {c['id']: c for c in comments}
        for c in comments:
            assert set(c) <= {'id', 'parent_id', 'author_name', 'date', 'html', 'author_url'}
            assert c['parent_id'] == 0 or c['parent_id'] in ids
            ancestors = {c['id']}
            parent = c['parent_id']
            while parent:
                assert parent not in ancestors, 'Comment ancestry cycle'
                ancestors.add(parent)
                parent = by_id[parent]['parent_id']
            assert not re.search(r'<(?:script|iframe)\b|\son\w+\s*=', c['html'], re.I)
        comment_count += len(comments)
        replies += sum(bool(c['parent_id']) for c in comments)
    assert comment_count == 107 and replies == 43 and len(seen_paths) == 125
    assert not manifest['missing_upload_references']
    print('Passed: 125 source/file hashes and routes, public field schemas, 107 threaded comments, 569 asset digests' + ('; full visible-text source parity' if raw else ''))


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', type=Path)
    parser.add_argument('--private-posts', type=Path, help='Optional PRIVATE allowlisted raw source JSON, never a build input')
    options = parser.parse_args()
    result = unittest.TextTestRunner(verbosity=1).run(unittest.defaultTestLoader.loadTestsFromTestCase(Safety))
    if not result.wasSuccessful():
        raise SystemExit(1)
    if options.source:
        check_corpus(options.source, options.private_posts)
