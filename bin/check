        'kb-section': ('https://kb.vpsfree.cz/navody/vps/uzivatele#detailni_nastaveni',
                       'https://kb.vpsfree.org/manuals/vps/users#advanced_settings'),
        'kb-cli': ('https://kb.vpsfree.cz/navody/vps/api#cli',
