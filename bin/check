        'kb-encoded': ('https://kb.vpsfree.cz/%6eavody/vps/api', 'https://kb.vpsfree.org/manuals/vps/api'),
        'kb-colon': ('//kb.vpsfree.cz/navody:vps:api', 'https://kb.vpsfree.org/manuals/vps/api'),
        'kb-entity': ('https://kb&#46;vpsfree&#46;cz/navody/vps/api', 'https://kb.vpsfree.org/manuals/vps/api'),
        'kb-query': ('http://kb.vpsfree.cz/navody/vps/api?source=preview&amp;value=a%26b%3Dc#prace_s_api',
                     'https://kb.vpsfree.org/manuals/vps/api?source=preview&amp;value=a%26b%3Dc#working_with_the_api'),
        'kb-cross': ('https://kb.vpsfree.cz/fixture/source?first=a%26b&amp;second=$value#old',
                     'https://kb.vpsfree.org/fixture/moved?first=a%26b&amp;second=$value#new-section'),
