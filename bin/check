    link_data = work / 'link-data'
    shutil.copytree(ROOT / 'data', link_data)
    link_map = json.loads((link_data / 'english-links.json').read_text())
    fixture_page = {'target': 'https://kb.vpsfree.org/fixture/original',
                    'fragments': {'old': 'same-page-must-lose'},
                    'fragment_targets': {'old': 'https://kb.vpsfree.org/fixture/moved#new-section'}}
    invalid_targets = {'scheme': 'http://kb.vpsfree.org/fixture/moved#new',
                       'host': 'https://kb.vpsfree.org.invalid/fixture/moved#new',
