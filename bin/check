        'kb-backup-download': ('https://kb.vpsfree.cz/navody/vps/datasety?first=a%26b&amp;second=$value#stahovani_zaloh',
                               'https://kb.vpsfree.org/manuals/vps/backups?first=a%26b&amp;second=$value#downloading_backups'),
