#!/usr/bin/env python3
"""Check the scaffold's route, isolation and reproducibility contracts."""
import argparse
import base64
from datetime import datetime
import hashlib
from html.parser import HTMLParser
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import tomllib
from urllib.request import build_opener, HTTPRedirectHandler
from urllib.parse import urlparse, urlsplit
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--preview', action='store_true', help='also check the running loopback preview')
vpn_checks = parser.add_mutually_exclusive_group()
vpn_checks.add_argument('--vpn', action='store_true', help='also check the running VPN fixture preview')
vpn_checks.add_argument('--real-vpn', action='store_true', help='also check the running real-content VPN preview')
options = parser.parse_args()


def run(*args):
    subprocess.run(args, cwd=ROOT, check=True, stdout=subprocess.DEVNULL)


def discover_articles(directory):
    sources = {}
    for source in sorted(directory.glob('*/index.*.*')):
        _, language, extension = source.name.split('.')
        if language not in ('cs', 'en') or extension not in ('md', 'html'):
            continue
        front = tomllib.loads(source.read_bytes().decode().split('+++', 2)[1])
        ident = front['params']['article_id']
        if not ident or front['translationKey'] != ident:
            raise ValueError('Article identity mismatch')
        variants = sources.setdefault(ident, {})
        if language in variants or any(p.parent != source.parent for p in variants.values()):
            raise ValueError('Duplicate article identity or split translation bundle')
        variants[language] = source
    return sources


ARTICLE_SOURCES = discover_articles(ROOT / 'content/posts')


def eligible(front, drafts=False, listed=True):
    date = front['date']
    date = datetime.fromisoformat(date.replace('Z', '+00:00')) if isinstance(date, str) else date
    return (drafts or not front.get('draft', False) and date <= datetime.now().astimezone()) and (not listed or not front.get('params', {}).get('unlisted', False))


def article_count(language, drafts=False, listed=True):
    return sum(language in variants and eligible(tomllib.loads(variants[language]
               .read_bytes().decode().split('+++', 2)[1]), drafts, listed)
               for variants in ARTICLE_SOURCES.values())


def taxonomy_memberships(sources, language, drafts=False):
    terms = {'categories': set(), 'tags': set()}
    for variants in sources.values():
        if language not in variants:
            continue
        front = tomllib.loads(variants[language].read_text().split('+++', 2)[1])
        if eligible(front, drafts):
            for kind in terms:
                terms[kind].update(front.get(kind, []))
    return terms


class Page(HTMLParser):
    def __init__(self, path=None, text=None):
        super().__init__()
        self.elements = []
        self.text = text if text is not None else path.read_text()
        self.feed(self.text)

    def handle_starttag(self, tag, attrs):
        self.elements.append((tag, dict(attrs)))

    def has(self, tag, **attrs):
        return any(t == tag and all(a.get(k) == v for k, v in attrs.items())
                   for t, a in self.elements)


def check_search_script(page, piwik_id=None):
    if page.has('meta', **{'http-equiv': 'refresh'}):
        piwik_id = None  # Hugo's redirect documents do not use the base layout.
    scripts = [(tag, attrs) for tag, attrs in page.elements if tag == 'script']
    tracking = [(tag, attrs) for tag, attrs in scripts if attrs.get('id') == 'piwik-tracking']
    assert len(tracking) == (1 if piwik_id else 0)
    pixels = [attrs for tag, attrs in page.elements
              if tag == 'img' and urlparse(attrs.get('src', '')).hostname == 'piwik.vpsfree.cz']
    assert len(pixels) == (1 if piwik_id else 0)
    if piwik_id:
        assert not tracking[0][1].get('src'), 'only the inline Piwik loader is allowed'
        script = re.search(r'(?s)<script\b[^>]*id="piwik-tracking"[^>]*>(.*?)</script>', page.text)[1]
        assert re.search(r"_paq\.push\(\['setSiteId',\s*" + str(piwik_id) + r"\s*\]\)", script)
        assert "_paq.push(['trackPageView'])" in script and "_paq.push(['enableLinkTracking'])" in script
        assert 'var u="//piwik.vpsfree.cz/"' in script
        assert "u+'piwik.php'" in script and "g.src=u+'piwik.js'" in script
        pixel = f'//piwik.vpsfree.cz/piwik.php?idsite={piwik_id}'
        assert pixels[0].get('src') == pixel
        assert re.search(r'<noscript>\s*<p>\s*<img\b[^>]*src="' + re.escape(pixel) + r'"', page.text)
    scripts = [(tag, attrs) for tag, attrs in scripts if attrs.get('id') != 'piwik-tracking']
    if scripts:
        assert page.has('section', **{'data-search-page': None})
        assert len(scripts) == 1
        attrs = scripts[0][1]
        assert attrs.get('type') == 'module' and re.fullmatch(r'/js/search\.[0-9a-f]+\.js', attrs.get('src', ''))
        assert attrs.get('integrity', '').startswith('sha256-')


class ArticleLinks(HTMLParser):
    """Read navigation in source HTML or the rendered article body, excluding examples."""
    def __init__(self, text, rendered=False):
        super().__init__()
        self.links, self.protected = [], []
        self.depth = 0 if rendered else None
        self.feed(text)

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if self.depth is not None and tag == 'div':
            if self.depth or 'data-pagefind-body' in attrs:
                self.depth += 1
        if tag in ('pre', 'code', 'script', 'style'):
            self.protected.append(tag)
        if tag == 'a' and 'href' in attrs and not self.protected and self.depth != 0:
            self.links.append(attrs['href'])

    def handle_endtag(self, tag):
        if self.depth and tag == 'div':
            self.depth -= 1
        if tag in self.protected:
            del self.protected[self.protected.index(tag):]


def check_real_english_links(destination, environment):
    """Account for every corpus href, including explicit unmapped KB destinations."""
    shared = json.loads((ROOT / 'data/articles.json').read_text())
    imported = json.loads((ROOT / 'data/migration/source-manifest.json').read_text())['articles']
    articles = {row['article_id']: shared[row['article_id']] for row in imported}
    mapping = json.loads((ROOT / 'data/english-links.json').read_text())
    originals = {urlparse(row['discussion_url']).path: aid for aid, row in articles.items()}
    routes = {aid: {lang: tomllib.loads(ARTICLE_SOURCES[aid][lang]
                                      .read_bytes().decode().split('+++')[1])['url']
                    for lang in ('cs', 'en')} for aid in articles}
    counts = dict(article=0, kb_mapped=0, kb_fallback=0, media=0, other=0)
    cli = []
    origin = 'http://localhost:1314' if environment == 'preview' else 'http://aitherdev.int.vpsfree.cz:4567'
    output = destination / 'en' if environment == 'preview' else destination
    for aid in articles:
        source = ARTICLE_SOURCES[aid]['en'].read_bytes()
        cs = ARTICLE_SOURCES[aid]['cs'].read_bytes()
        front = tomllib.loads(source.decode().split('+++')[1])
        assert front['params']['translation_source_sha256'] == hashlib.sha256(cs).hexdigest()
        source_links = ArticleLinks(source.decode().split('+++', 2)[2]).links
        assert source_links == ArticleLinks(cs.decode().split('+++', 2)[2]).links
        page = output / routes[aid]['en'].strip('/') / 'index.html'
        rendered_links = ArticleLinks(page.read_text(), rendered=True).links
        assert len(source_links) == len(rendered_links), aid
        for original, rendered in zip(source_links, rendered_links):
            parsed = urlsplit(original)
            expected = original
            if parsed.netloc in ('', 'blog.vpsfree.cz') and parsed.path in originals:
                assert not parsed.query and not parsed.fragment
                target = originals[parsed.path]
                expected = origin + routes[target]['en']
                assert (output / routes[target]['en'].strip('/') / 'index.html').is_file()
                counts['article'] += 1
            elif parsed.netloc == 'kb.vpsfree.cz':
                page_id = mapping.get('aliases', {}).get(parsed.path, parsed.path.strip('/').replace('/', ':'))
                entry = mapping['pages'].get(page_id)
                if entry and parsed.fragment in entry.get('fragment_targets', {}):
                    expected = entry['fragment_targets'][parsed.fragment]
                    counts['kb_mapped'] += 1
                elif entry and (not parsed.fragment or parsed.fragment in entry['fragments']):
                    expected = entry['target'] + ('#' + entry['fragments'][parsed.fragment] if parsed.fragment else '')
                    counts['kb_mapped'] += 1
                else:
                    counts['kb_fallback'] += 1
                if original == 'https://kb.vpsfree.cz/navody/vps/api#cli':
                    assert rendered == 'https://kb.vpsfree.org/manuals/vps/api#using_cli', aid
                    cli.append(aid)
            elif parsed.netloc == 'blog.vpsfree.cz' and parsed.path.startswith('/wp-content/uploads/'):
                expected = parsed.path
                counts['media'] += 1
            else:
                counts['other'] += 1
            assert rendered == expected, (environment, aid, original, rendered, expected)
    assert sorted(cli) == sorted(['wp-253', 'wp-264', 'wp-284', 'wp-284', 'wp-455',
                                  'wp-474', 'wp-490', 'wp-601', 'wp-709']), cli
    assert counts == dict(article=55, kb_mapped=67, kb_fallback=3, media=75, other=331), counts


def check_search_index(root, counts):
    if not sum(counts.values()):
        assert not (root / 'pagefind').exists(), 'zero articles must not trigger whole-site fallback'
        return
    entry = json.loads((root / 'pagefind/pagefind-entry.json').read_text())
    assert {lang: data['page_count'] for lang, data in entry['languages'].items()} == counts
    assert (root / 'pagefind/pagefind.js').is_file()
    script = (root / 'pagefind/pagefind.js').read_text()
    assert 'pagefind-entry.json' in script and 'Date.now()' in script


def digest_tree(path):
    return {str(p.relative_to(path)): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in path.rglob('*') if p.is_file()}


def check_join_graphic():
    original = (ROOT / 'static/theme/branding/pridej-se.png').read_bytes()
    assert hashlib.sha256(original).hexdigest() == '8b73dbbdbc5dfa666196bde128afb12652c0638ede5f9a905e3da7042343f5da'
    graphic = ET.parse(ROOT / 'static/theme/branding/join-us.svg').getroot()
    namespace = '{http://www.w3.org/2000/svg}'
    assert graphic.findtext(namespace + 'text') == 'Join us'
    images = graphic.findall('.//' + namespace + 'image')
    assert len(images) == 1
    assert base64.b64decode(images[0].get('href').removeprefix('data:image/png;base64,'), validate=True) == original
    for element in graphic.iter():
        assert element.tag not in (namespace + 'script', namespace + 'foreignObject')
        for name, value in element.attrib.items():
            assert not name.lower().startswith('on'), name
            if name == 'href':
                assert value.startswith(('#', 'data:image/png;base64,')), 'CTA must be self-contained'


def check_roots(destination, hosts, piwik_ids=None):
    for lang, host in hosts.items():
        piwik_id = (piwik_ids or {}).get(lang)
        root = destination / lang
        assert (root / 'index.html').is_file(), root
        assert (root / 'sitemap.xml').is_file(), root
        feed = ET.parse(root / 'feed/index.xml').getroot()
        assert feed.findtext('channel/link') == host
        assert feed.find('channel/{http://www.w3.org/2005/Atom}link').get('href') == host + 'feed/'
        page = Page(root / 'index.html')
        assert page.has('link', rel='canonical', href=host)
        registration = 'https://vpsfree.cz/registrace/' if lang == 'cs' else 'https://vpsfree.org/registration/'
        graphic, label = ('pridej-se.png', 'Přidej se') if lang == 'cs' else ('join-us.svg', 'Join us')
        assert page.has('a', href=registration), lang
        assert page.has('img', src='/theme/branding/' + graphic, alt=label, width='150', height='147'), lang
        assert page.has('a', href='https://vpsfree.cz/' if lang == 'cs' else 'https://vpsfree.org/'), lang
        assert page.has('a', href='/'), 'logo must retain the current language home'
        for path in root.rglob('*.html'):
            text = path.read_text()
            check_search_script(Page(path), piwik_id)
            assert 'DiscourseEmbed' not in text, path
            assert not any(t == 'iframe' and 'discourse.vpsfree.cz' in a.get('src', '') for t, a in Page(path).elements), path
            for tag, attrs in Page(path).elements:
                if tag in ('img', 'source'):
                    if piwik_id and tag == 'img' and attrs.get('src') == f'//piwik.vpsfree.cz/piwik.php?idsite={piwik_id}':
                        continue  # The exact noscript pixel was checked above.
                    for key in ('src', 'srcset'):
                        for candidate in attrs.get(key, '').split(','):
                            if candidate.strip():
                                url = candidate.strip().split()[0]
                                assert not urlparse(url).netloc, (path, url)
                                assert (root / urlparse(url).path.lstrip('/')).is_file(), (path, url)

            for tag, attrs in Page(path).elements:
                if tag == 'link' and attrs.get('rel') == 'canonical':
                    assert not urlparse(attrs['href']).path.startswith(('/en/', '/cs/')), path


def check_piwik_guards(work):
    """Inspect rendered HTML only; never execute a tracker or request its endpoints."""
    content = work / 'piwik-content'
    content.mkdir()
    for language in ('cs', 'en'):
        (content / f'published.{language}.md').write_text('+++\ntitle="Synthetic tracking check"\n'
            'date="2026-01-01T12:00:00+01:00"\ntype="posts"\n'
            f'url="/tracking-{language}/"\ntranslationKey="tracking-check"\n'
            '[params]\narticle_id="tracking-check"\n+++\nSynthetic local render only.\n')
    cases = (('production', 91), ('production', 0), ('production', -1),
             ('preview', 91), ('vpn', 91))
    for number, (environment, english_id) in enumerate(cases):
        overlay = work / f'piwik-{number}.json'
        overlay.write_text(json.dumps({'languages': {'en': {'params': {'piwikSiteId': english_id}}}}))
        destination = work / f'piwik-{number}'
        run('hugo', '--environment', environment, '--contentDir', str(content),
            '--config', f'hugo.toml,{overlay}', '--destination', str(destination), '--panicOnWarning')
        for path in destination.rglob('*.html'):
            page = Page(path)
            expected = None
            if environment == 'production':
                expected = 4 if page.has('html', lang='cs-CZ') else (english_id if english_id > 0 else None)
            check_search_script(page, expected)


def check_preview_isolation(work):
    stubs, output = work / 'preview-bin', work / 'preview-output'
    stubs.mkdir()
    output.mkdir()
    hugo = stubs / 'hugo'
    hugo.write_text('#!/usr/bin/env python3\nimport json, pathlib, sys\n'
        'args = sys.argv[1:]\n'
        'destination = pathlib.Path(args[args.index("--destination") + 1])\n'
        'mode = args[args.index("--environment") + 1]\n'
        '(destination / "en").mkdir(exist_ok=True)\n'
        '(destination / "en/index.html").write_text(mode)\n'
        'assert "--buildDrafts" in args and "--buildFuture" in args\n'
        'if args[0] == "server":\n'
        '    assert "--watch=false" in args and "--cleanDestinationDir" not in args\n'
        '    bundle = destination / ("pagefind" if mode == "vpn" else "cs/pagefind") / "pagefind.js"\n'
        '    assert bundle.is_file(), "server must preserve pre-generated search bundle"\n'
        '    print(json.dumps({"destination": str(destination), "mode": mode}))\n')
    # The actual shared helper runs the pinned CLI against this marked prebuild.
    with hugo.open('a') as target:
        target.write('else:\n'
            '    article = destination / ("example" if mode == "vpn" else "cs/example") / "index.html"\n'
            '    article.parent.mkdir(parents=True)\n'
            '    article.write_text(\'<html lang="cs-CZ"><article data-search-article><h1 data-pagefind-body>Fixture</h1></article></html>\')\n')
    hugo.chmod(0o755)
    results = []
    for flags in (('--fixtures',), ('--vpn',), ('--vpn', '--fixtures')):
        result = subprocess.run(['bin/preview', *flags], cwd=ROOT, check=True,
            env={**os.environ, 'PATH': str(stubs) + os.pathsep + os.environ['PATH'], 'TMPDIR': str(output)},
            capture_output=True, text=True)
        results.append(json.loads(result.stdout.splitlines()[-1]))
    assert len({item['destination'] for item in results}) == 3
    for item in results:
        destination = Path(item['destination'])
        assert destination.parent == output
        assert (destination / 'en/index.html').read_text() == item['mode']


def check_authored_article(work):
    """Render one additional pair, then exclude its draft form without changing source."""
    content, data = work / 'authored-content', work / 'authored-data'
    shutil.copytree(ROOT / 'content', content)
    shutil.copytree(ROOT / 'data', data)
    bundle = content / 'posts/2020-01-01-authored-example'
    bundle.mkdir()
    shared = json.loads((data / 'articles.json').read_text())
    shared['post-authored-check'] = {'author_ids': ['wp-user-6'],
        'discussion_url': 'https://blog.vpsfree.cz/autorsky-priklad/',
        'feed_guids': {lang: f'urn:vpsfree:blog:post-authored-check:{lang}' for lang in ('cs', 'en')}}
    (data / 'articles.json').write_text(json.dumps(shared))
    config = work / 'authored-config.json'
    config.write_text(json.dumps({'dataDir': str(data)}))
    for lang, title, route in [('cs', 'Autorský příklad', '/autorsky-priklad/'),
                               ('en', 'Authored example', '/authored-example/')]:
        (bundle / f'index.{lang}.md').write_text(
            f'+++\ntitle = "{title}"\ndate = "2020-01-01T10:00:00+01:00"\n'
            f'lastmod = "2020-01-01T10:00:00+01:00"\ndraft = false\nurl = "{route}"\n'
            'translationKey = "post-authored-check"\n[params]\narticle_id = "post-authored-check"\n'
            '+++\nArticle fixture.\n')
    for draft in (False, True):
        if draft:
            for path in bundle.iterdir():
                path.write_text(path.read_text().replace('draft = false', 'draft = true'))
        destination = work / ('authored-draft' if draft else 'authored-production')
        run('hugo', '--environment', 'production', '--contentDir', str(content),
            '--config', f'hugo.toml,{config}', '--destination', str(destination), '--panicOnWarning')
        run('bin/index-search', str(destination))
        for lang, route in [('cs', 'autorsky-priklad'), ('en', 'authored-example')]:
            assert (destination / lang / route / 'index.html').exists() is not draft
            check_search_index(destination / lang,
                {'cs-cz' if lang == 'cs' else 'en': article_count(lang) + (not draft)})


def check_article_states(work, index=True):
    """Tiny real-Hugo state fixture, also indexed by the full check batch."""
    site = work / 'states-site'
    site.mkdir()
    for name in ('assets', 'layouts', 'i18n', 'config', 'hugo.toml'):
        (site / name).symlink_to(ROOT / name, target_is_directory=(ROOT / name).is_dir())
    content, data = site / 'content', work / 'states-data'
    (content / 'posts').mkdir(parents=True)
    data.mkdir()
    shutil.copy2(ROOT / 'content/_content.gotmpl', content)
    shutil.copytree(ROOT / 'content/search', content / 'search')
    shared, authors = {}, {}
    states = {'public': ('2019-01-01', False, False),
              'review': ('2020-02-01', False, True),
              'draft': ('2099-03-01', True, False)}
    for name, (date, draft, unlisted) in states.items():
        ident = 'post-' + name
        authors[name] = {'name': name.title() + ' Author', 'slug': name + '-author'}
        shared[ident] = {'author_ids': [name], 'discussion_url': f'https://blog.vpsfree.cz/{name}-cs/',
                         'feed_guids': {lang: f'urn:vpsfree:blog:{ident}:{lang}' for lang in ('cs', 'en')}}
        bundle = content / 'posts' / (date + '-' + name)
        bundle.mkdir()
        for lang in ('cs', 'en'):
            (bundle / f'index.{lang}.md').write_text(
                f'+++\ntitle="{name.title()} {lang} distinctive"\ndate="{date}T10:00:00+01:00"\n'
                f'lastmod="{date}T10:00:00+01:00"\ndraft={str(draft).lower()}\n'
                f'url="/{name}-{lang}/"\ntranslationKey="{ident}"\n'
                f'categories=["mixed", "{name}-only"]\ntags=["mixed", "{name}-only"]\n'
                f'[params]\narticle_id="{ident}"\nunlisted={str(unlisted).lower()}\n+++\n'
                f'{name.title()} article body.\n')
    (data / 'articles.json').write_text(json.dumps(shared))
    (data / 'authors.json').write_text(json.dumps(authors))
    (data / 'taxonomies.json').write_text(json.dumps({kind: {slug: {'name': slug} for slug in
        ('mixed', 'public-only', 'review-only', 'draft-only')} for kind in ('tags', 'categories')}))
    overlay = work / 'states.json'
    overlay.write_text(json.dumps({'dataDir': str(data), 'staticDir': [],
                                  'params': {'discourse': {'enabled': True}}}))
    for phase in ('production', 'promotion', 'preview'):
        if phase == 'promotion':
            for path in (content / 'posts/2020-02-01-review').iterdir():
                path.write_text(path.read_text().replace('unlisted=true', 'unlisted=false')
                                .replace('2020-02-01T10:00:00+01:00', '2021-04-01T10:00:00+01:00'))
        if phase == 'preview':
            for path in (content / 'posts/2020-02-01-review').iterdir():
                path.write_text(path.read_text().replace('unlisted=false', 'unlisted=true'))
        destination = work / ('states-' + phase)
        flags = ('--buildDrafts', '--buildFuture') if phase == 'preview' else ()
        run('hugo', '--environment', 'preview' if phase == 'preview' else 'production',
            '--source', str(site), '--config', f'hugo.toml,{overlay}',
            '--destination', str(destination), '--panicOnWarning', *flags)
        if index:
            run('bin/index-search', str(destination))
        for lang in ('cs', 'en'):
            root = destination / lang
            listed = {'public', 'review'} if phase == 'promotion' else {'public', 'draft'} if phase == 'preview' else {'public'}
            rendered = listed | {'review'}
            for name in states:
                path = root / f'{name}-{lang}/index.html'
                assert path.is_file() == (name in rendered), (phase, name, lang)
                if not path.is_file():
                    continue
                page = Page(path)
                unlisted = name == 'review' and phase != 'promotion'
                state = 'unlisted' if unlisted else 'draft' if name == 'draft' else 'published'
                assert page.has('article', **{'data-article-state': state})
                assert any(tag == 'p' and 'data-unlisted-notice' in attrs for tag, attrs in page.elements) == unlisted
                assert page.has('meta', name='robots', content='noindex, nofollow') == (unlisted or phase == 'preview')
                assert any(tag == 'article' and 'data-search-article' in attrs for tag, attrs in page.elements) == (not unlisted)
                assert ('data-pagefind-body' in page.text) == (not unlisted)
                assert ('window.DiscourseEmbed =' in page.text) == (phase != 'preview' and not unlisted)
                assert page.has('div', id='respond') == (state == 'published')
                host = ('http://localhost:1313/' if lang == 'cs' else 'http://localhost:1314/') if phase == 'preview' else ('https://blog.vpsfree.cz/' if lang == 'cs' else 'https://blog.vpsfree.org/')
                other_host = ('http://localhost:1314/' if lang == 'cs' else 'http://localhost:1313/') if phase == 'preview' else ('https://blog.vpsfree.org/' if lang == 'cs' else 'https://blog.vpsfree.cz/')
                assert page.has('link', rel='canonical', href=host + f'{name}-{lang}/')
                assert page.has('link', rel='alternate', href=other_host + f'{name}-' + ('en' if lang == 'cs' else 'cs') + '/', hreflang='en' if lang == 'cs' else 'cs-CZ')
                assert (root / f'author/{name}-author/index.html').is_file() == (name in listed)
                assert any(t == 'a' and a.get('href') == f'/author/{name}-author/' for t, a in page.elements) == (name in listed)
            sitemap = ET.parse(root / 'sitemap.xml')
            urls = [element.text or element.get('href', '') for element in sitemap.iter()]
            feed = (root / 'feed/index.xml').read_text()
            for name in states:
                assert any(f'/{name}-{lang}/' in url for url in urls) == (name in listed)
                assert (f'/{name}-{lang}/' in feed) == (name in listed)
            if phase != 'promotion':
                assert not (root / ('2021/04/index.html' if phase == 'preview' else '2020/02/index.html')).exists()
                for path in root.rglob('*.html'):
                    if path == root / f'review-{lang}/index.html':
                        continue
                    text = path.read_text()
                    assert f'/review-{lang}/' not in text, path
                    assert not any(tag == 'a' and attrs.get('href') in ('/category/review-only/', '/tag/review-only/')
                                   for tag, attrs in Page(path).elements), path
            required = taxonomy_memberships(discover_articles(content / 'posts'), lang, drafts=phase == 'preview')
            for kind, prefix in (('categories', 'category'), ('tags', 'tag')):
                assert required[kind] == {'mixed'} | {name + '-only' for name in listed}
                for slug in ('mixed', 'public-only', 'review-only', 'draft-only'):
                    assert Page(root / 'index.html').has('a', href=f'/{prefix}/{slug}/') == (slug in required[kind])
                    if slug in required[kind]:
                        assert (root / prefix / slug / 'index.html').is_file()
            mixed = Page(root / 'category/mixed/index.html')
            assert re.search(r'href="/category/mixed/">mixed</a> \((\d+)\)', Page(root / 'index.html').text)[1] == str(len(listed))
            assert f'/review-{lang}/' in mixed.text if phase == 'promotion' else f'/review-{lang}/' not in mixed.text
            if index:
                check_search_index(root, {'cs-cz' if lang == 'cs' else 'en': len(listed)})
    print('Three-state bilingual fixture passed: direct pages, promotion, discovery, future preview and discussion')


def check_taxonomy_labels(work):
    destination = work / 'taxonomy-preview'
    run('hugo', '--environment', 'preview', '--buildDrafts', '--buildFuture', '--destination', str(destination), '--panicOnWarning')
    check_real_english_links(destination, 'preview')
    run('bin/index-search', str(destination))
    check_search_index(destination / 'cs', {'cs-cz': article_count('cs', drafts=True)})
    check_search_index(destination / 'en', {'en': article_count('en', drafts=True)})
    translations = {'categories': {'akce': 'Events', 'bezpecnost': 'Security',
                    'distribuce': 'Distributions', 'nezarazene': 'Uncategorized',
                    'podpora': 'Support', 'skoly': 'Schools', 'technologie': 'Technology'},
                    'tags': {'energie': 'energy', 'sit': 'network'}}

    class Labels(HTMLParser):
        def __init__(self, path):
            super().__init__()
            self.active, self.labels = [], []
            self.feed(path.read_text())

        def handle_starttag(self, tag, attrs):
            if tag in ('a', 'h1'):
                self.active.append((tag, dict(attrs), []))

        def handle_data(self, text):
            for _, _, parts in self.active:
                parts.append(text)

        def handle_endtag(self, tag):
            if self.active and self.active[-1][0] == tag:
                name, attrs, parts = self.active.pop()
                self.labels.append((name, attrs, ''.join(parts)))

    taxonomies = json.loads((ROOT / 'data/taxonomies.json').read_text())
    for lang in ('cs', 'en'):
        home = Labels(destination / lang / 'index.html').labels
        required = taxonomy_memberships(ARTICLE_SOURCES, lang, drafts=True)
        for kind, prefix in (('categories', 'category'), ('tags', 'tag')):
            for slug, term in taxonomies[kind].items():
                expected = translations[kind].get(slug, term['name']) if lang == 'en' else term['name']
                route = f'/{prefix}/{slug}/'
                linked = any(tag == 'a' and attrs.get('href') == route for tag, attrs, _ in home)
                assert linked == (slug in required[kind]), (lang, kind, slug)
                if slug in required[kind]:
                    assert any(tag == 'a' and attrs.get('href') == route and text == expected
                               for tag, attrs, text in home), (lang, kind, slug)
                    archive = Labels(destination / lang / route.strip('/') / 'index.html').labels
                    assert any(tag == 'h1' and text == expected for tag, _, text in archive), (lang, kind, slug)
    # Article association labels use the same resolver as the sidebar and headings.
    for source in (ROOT / 'content/posts').glob('*/index.en.*'):
        frontmatter = tomllib.loads(source.read_text().split('+++')[1])
        labels = Labels(destination / 'en' / frontmatter['url'].strip('/') / 'index.html').labels
        for kind, prefix in (('categories', 'category'), ('tags', 'tag')):
            for slug in frontmatter.get(kind, []):
                expected = translations[kind].get(slug, taxonomies[kind][slug]['name'])
                assert any(tag == 'a' and attrs.get('href') == f'/{prefix}/{slug}/' and text == expected
                           for tag, attrs, text in labels), (source, kind, slug)


def check_discussions(work):
    content, data, config_dir = (work / name for name in ('discussion-content', 'discussion-data', 'empty-config'))
    for path in (content, data, config_dir):
        path.mkdir()
    source_url = 'https://blog.vpsfree.cz/shared-discussion-fixture/'
    sources = {'published': source_url, 'draft': source_url, 'unlisted': source_url,
               'unmapped': source_url, 'multiple': source_url,
               'escaped': 'https://blog.vpsfree.cz/a&b/',
               'wrong-host': 'https://blog.vpsfree.cz.invalid/article/',
               'query': source_url + '?preview=1', 'fragment': source_url + '#comments',
               'port': 'https://blog.vpsfree.cz:443/article/'}
    authors = {'wp-user-6': {'name': 'Jakub Skokan', 'slug': 'aither'},
               'wp-user-1': {'name': 'Petr Krčmář', 'slug': 'krcmar'},
               'wp-user-2': {'name': 'Jiří Medvěd', 'slug': 'medved'},
               'fixture-special': {'name': 'Jméno "citace" & <em data-p30-injected>', 'slug': 'special'}}
    author_ids = {key: ['wp-user-6'] for key in sources}
    author_ids.update(unmapped=['wp-user-2'], multiple=['wp-user-6', 'wp-user-1'], escaped=['fixture-special'])
    (data / 'articles.json').write_text(json.dumps({key: {'discussion_url': value, 'author_ids': author_ids[key]}
                                                  for key, value in sources.items()}))
    (data / 'authors.json').write_text(json.dumps(authors))
    (data / 'taxonomies.json').write_text(json.dumps({'tags': {}, 'categories': {'p30-fixture': {'name': 'Fixture'}}}))
    shutil.copytree(ROOT / 'content/search', content / 'search')
    usernames = {'wp-user-6': 'aither', 'wp-user-1': 'krcmar', 'fixture-special': 'special'}

    class AuthorHead(HTMLParser):
        def __init__(self, text):
            super().__init__()
            self.metadata, self.byline, self.depth = {}, [], 0
            self.feed(text)

        def handle_starttag(self, tag, attrs):
            attrs = dict(attrs)
            if tag == 'meta' and attrs.get('name') in ('author', 'discourse-username'):
                self.metadata.setdefault(attrs['name'], []).append(attrs.get('content'))
            if tag == 'div' and (self.depth or attrs.get('class') == 'entry-meta'):
                self.depth += 1

        def handle_endtag(self, tag):
            if tag == 'div' and self.depth:
                self.depth -= 1

        def handle_data(self, text):
            if self.depth:
                self.byline.append(text)
    for article_id in sources:
        for lang in ('cs', 'en'):
            (content / f'{article_id}.{lang}.html').write_text('+++\ntitle = "Synthetic discussion check"\n'
                'date = "2026-01-01T12:00:00+01:00"\ntype = "posts"\n'
                f'draft = {str(article_id == "draft").lower()}\n'
                f'url = "/discussion-{article_id}-{lang}/"\ncategories = ["p30-fixture"]\n'
                f'translationKey = "discussion-{article_id}"\n[params]\narticle_id = "{article_id}"\n'
                f'unlisted = {str(article_id == "unlisted").lower()}\n'
                '+++\n<p>Synthetic local check only.</p>\n')
    cases = (('production', True, False, True), ('production', False, False, False),
             ('preview', True, False, True), ('vpn', True, False, True), ('production', True, True, True))
    for number, (environment, enabled, wrong_origin, mapped) in enumerate(cases):
        mapping_path = data / 'discourse-authors.json'
        if mapped:
            mapping_path.write_text(json.dumps(usernames))
        elif mapping_path.exists():
            mapping_path.unlink()
        config = tomllib.loads((ROOT / 'hugo.toml').read_text())
        config.update(contentDir=str(content), dataDir=str(data))
        config['params']['discourse']['enabled'] = enabled
        for lang, host in (('cs', 'blog.vpsfree.cz'), ('en', 'blog.vpsfree.org')):
            config['languages'][lang]['baseURL'] = f'https://{lang}.preview.invalid/' if wrong_origin else f'https://{host}/'
        config_path = work / f'discussion-{number}.json'
        config_path.write_text(json.dumps(config))
        destination = work / f'discussion-{number}'
        run('hugo', '--environment', environment, '--buildDrafts', '--configDir', str(config_dir),
            '--config', str(config_path), '--destination', str(destination), '--panicOnWarning')
        identities = []
        for article_id in sources:
            for lang in ('cs', 'en'):
                path = destination / lang / f'discussion-{article_id}-{lang}/index.html'
                text = path.read_text()
                head = AuthorHead(text)
                names = [authors[ident]['name'] for ident in author_ids[article_id]]
                username = usernames.get(author_ids[article_id][0], '') if mapped and len(names) == 1 else ''
                assert head.metadata == {'author': [', '.join(names)], 'discourse-username': [username]}
                assert all(name in ''.join(head.byline) for name in names)
                assert not any(tag == 'em' and 'data-p30-injected' in attrs for tag, attrs in Page(path).elements)
                should_embed = environment == 'production' and enabled and not wrong_origin and article_id in ('published', 'escaped', 'unmapped', 'multiple')
                assert ('window.DiscourseEmbed =' in text) == should_embed, (number, article_id, lang)
                published = article_id not in ('draft', 'unlisted')
                assert Page(path).has('a', href='https://discourse.vpsfree.cz/') == published
                assert Page(path).has('div', id='respond') == published
                assert Page(path).has('div', id='discourse-comments') == should_embed
                if should_embed:
                    encoded = text.split('window.DiscourseEmbed = ', 1)[1]
                    payload, _ = json.JSONDecoder().raw_decode(encoded)
                    assert payload == {'discourseUrl': 'https://discourse.vpsfree.cz/',
                                       'discourseEmbedUrl': sources[article_id]}
                    if article_id == 'published':
                        identities.append(payload['discourseEmbedUrl'])
                    if article_id == 'escaped':
                        assert r'\u0026' in encoded
                    assert Page(path).has('div', id='discourse-comments')
        if identities:
            assert identities == [source_url, source_url]
        article_paths = {destination / lang / f'discussion-{ident}-{lang}/index.html' for ident in sources for lang in ('cs', 'en')}
        for path in destination.rglob('*.html'):
            if path not in article_paths:
                assert not AuthorHead(path.read_text()).metadata, path
    print('Article author metadata: mapped/unmapped/multiple/escaped, both languages, optional map and embed guards PASS')


