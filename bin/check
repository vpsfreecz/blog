#!/usr/bin/env python3
"""Check the scaffold's route, isolation and reproducibility contracts."""
import argparse
import base64
import hashlib
from html.parser import HTMLParser
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile
import tomllib
from urllib.request import build_opener, HTTPRedirectHandler
from urllib.parse import urlparse
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--preview', action='store_true', help='also check the running loopback preview')
vpn_checks = parser.add_mutually_exclusive_group()
vpn_checks.add_argument('--vpn', action='store_true', help='also check the running VPN fixture preview')
vpn_checks.add_argument('--real-vpn', action='store_true', help='also check the running real-content VPN preview')
options = parser.parse_args()


def run(*args):
    subprocess.run(args, cwd=ROOT, check=True, stdout=subprocess.DEVNULL)


class Page(HTMLParser):
    def __init__(self, path=None, text=None):
        super().__init__()
        self.elements = []
        self.feed(text if text is not None else path.read_text())

    def handle_starttag(self, tag, attrs):
        self.elements.append((tag, dict(attrs)))

    def has(self, tag, **attrs):
        return any(t == tag and all(a.get(k) == v for k, v in attrs.items())
                   for t, a in self.elements)


def check_search_script(page):
    scripts = [(tag, attrs) for tag, attrs in page.elements if tag == 'script']
    if scripts:
        assert page.has('section', **{'data-search-page': None})
        assert len(scripts) == 1
        attrs = scripts[0][1]
        assert attrs.get('type') == 'module' and re.fullmatch(r'/js/search\.[0-9a-f]+\.js', attrs.get('src', ''))
        assert attrs.get('integrity', '').startswith('sha256-')


def check_search_index(root, counts):
    if not sum(counts.values()):
        assert not (root / 'pagefind').exists(), 'zero articles must not trigger whole-site fallback'
        return
    entry = json.loads((root / 'pagefind/pagefind-entry.json').read_text())
    assert {lang: data['page_count'] for lang, data in entry['languages'].items()} == counts
    assert (root / 'pagefind/pagefind.js').is_file()
    script = (root / 'pagefind/pagefind.js').read_text()
    assert 'pagefind-entry.json' in script and 'Date.now()' in script


def digest_tree(path):
    return {str(p.relative_to(path)): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in path.rglob('*') if p.is_file()}


def check_join_graphic():
    original = (ROOT / 'static/theme/branding/pridej-se.png').read_bytes()
    assert hashlib.sha256(original).hexdigest() == '8b73dbbdbc5dfa666196bde128afb12652c0638ede5f9a905e3da7042343f5da'
    graphic = ET.parse(ROOT / 'static/theme/branding/join-us.svg').getroot()
    namespace = '{http://www.w3.org/2000/svg}'
    assert graphic.findtext(namespace + 'text') == 'Join us'
    images = graphic.findall('.//' + namespace + 'image')
    assert len(images) == 1
    assert base64.b64decode(images[0].get('href').removeprefix('data:image/png;base64,'), validate=True) == original
    for element in graphic.iter():
        assert element.tag not in (namespace + 'script', namespace + 'foreignObject')
        for name, value in element.attrib.items():
            assert not name.lower().startswith('on'), name
            if name == 'href':
                assert value.startswith(('#', 'data:image/png;base64,')), 'CTA must be self-contained'


def check_roots(destination, hosts):
    for lang, host in hosts.items():
        root = destination / lang
        assert (root / 'index.html').is_file(), root
        assert (root / 'sitemap.xml').is_file(), root
        feed = ET.parse(root / 'feed/index.xml').getroot()
        assert feed.findtext('channel/link') == host
        assert feed.find('channel/{http://www.w3.org/2005/Atom}link').get('href') == host + 'feed/'
        page = Page(root / 'index.html')
        assert page.has('link', rel='canonical', href=host)
        registration = 'https://vpsfree.cz/registrace/' if lang == 'cs' else 'https://vpsfree.org/registration/'
        graphic, label = ('pridej-se.png', 'Přidej se') if lang == 'cs' else ('join-us.svg', 'Join us')
        assert page.has('a', href=registration), lang
        assert page.has('img', src='/theme/branding/' + graphic, alt=label, width='150', height='147'), lang
        assert page.has('a', href='https://vpsfree.cz/' if lang == 'cs' else 'https://vpsfree.org/'), lang
        assert page.has('a', href='/'), 'logo must retain the current language home'
        for path in root.rglob('*.html'):
            text = path.read_text()
            check_search_script(Page(path))
            assert 'DiscourseEmbed' not in text, path
            assert not any(t == 'iframe' and 'discourse.vpsfree.cz' in a.get('src', '') for t, a in Page(path).elements), path
            for tag, attrs in Page(path).elements:
                if tag in ('img', 'source'):
                    for key in ('src', 'srcset'):
                        for candidate in attrs.get(key, '').split(','):
                            if candidate.strip():
                                url = candidate.strip().split()[0]
                                assert not urlparse(url).netloc, (path, url)
                                assert (root / urlparse(url).path.lstrip('/')).is_file(), (path, url)

            for tag, attrs in Page(path).elements:
                if tag == 'link' and attrs.get('rel') == 'canonical':
                    assert not urlparse(attrs['href']).path.startswith(('/en/', '/cs/')), path


def check_preview_isolation(work):
    stubs, output = work / 'preview-bin', work / 'preview-output'
    stubs.mkdir()
    output.mkdir()
    hugo = stubs / 'hugo'
    hugo.write_text('#!/usr/bin/env python3\nimport json, pathlib, sys\n'
        'args = sys.argv[1:]\n'
        'destination = pathlib.Path(args[args.index("--destination") + 1])\n'
        'mode = args[args.index("--environment") + 1]\n'
        '(destination / "en").mkdir(exist_ok=True)\n'
        '(destination / "en/index.html").write_text(mode)\n'
        'if args[0] == "server":\n'
        '    assert "--watch=false" in args and "--cleanDestinationDir" not in args\n'
        '    bundle = destination / ("pagefind" if mode == "vpn" else "cs/pagefind") / "pagefind.js"\n'
        '    assert bundle.is_file(), "server must preserve pre-generated search bundle"\n'
        '    print(json.dumps({"destination": str(destination), "mode": mode}))\n')
    # The actual shared helper runs the pinned CLI against this marked prebuild.
    with hugo.open('a') as target:
        target.write('else:\n'
            '    article = destination / ("example" if mode == "vpn" else "cs/example") / "index.html"\n'
            '    article.parent.mkdir(parents=True)\n'
            '    article.write_text(\'<html lang="cs-CZ"><article data-search-article><h1 data-pagefind-body>Fixture</h1></article></html>\')\n')
    hugo.chmod(0o755)
    results = []
    for flags in (('--fixtures',), ('--vpn',), ('--vpn', '--fixtures')):
        result = subprocess.run(['bin/preview', *flags], cwd=ROOT, check=True,
            env={**os.environ, 'PATH': str(stubs) + os.pathsep + os.environ['PATH'], 'TMPDIR': str(output)},
            capture_output=True, text=True)
        results.append(json.loads(result.stdout.splitlines()[-1]))
    assert len({item['destination'] for item in results}) == 3
    for item in results:
        destination = Path(item['destination'])
        assert destination.parent == output
        assert (destination / 'en/index.html').read_text() == item['mode']


def check_taxonomy_labels(work):
    destination = work / 'taxonomy-preview'
    run('hugo', '--environment', 'preview', '--buildDrafts', '--destination', str(destination), '--panicOnWarning')
    run('bin/index-search', str(destination))
    check_search_index(destination / 'cs', {'cs-cz': 125})
    check_search_index(destination / 'en', {'en': 125})
    translations = {'categories': {'akce': 'Events', 'bezpecnost': 'Security',
                    'distribuce': 'Distributions', 'nezarazene': 'Uncategorized',
                    'podpora': 'Support', 'skoly': 'Schools', 'technologie': 'Technology'},
                    'tags': {'energie': 'energy', 'sit': 'network'}}

    class Labels(HTMLParser):
        def __init__(self, path):
            super().__init__()
            self.active, self.labels = [], []
            self.feed(path.read_text())

        def handle_starttag(self, tag, attrs):
            if tag in ('a', 'h1'):
                self.active.append((tag, dict(attrs), []))

        def handle_data(self, text):
            for _, _, parts in self.active:
                parts.append(text)

        def handle_endtag(self, tag):
            if self.active and self.active[-1][0] == tag:
                name, attrs, parts = self.active.pop()
                self.labels.append((name, attrs, ''.join(parts)))

    taxonomies = json.loads((ROOT / 'data/taxonomies.json').read_text())
    for lang in ('cs', 'en'):
        home = Labels(destination / lang / 'index.html').labels
        for kind, prefix in (('categories', 'category'), ('tags', 'tag')):
            for slug, term in taxonomies[kind].items():
                expected = translations[kind].get(slug, term['name']) if lang == 'en' else term['name']
                route = f'/{prefix}/{slug}/'
                assert any(tag == 'a' and attrs.get('href') == route and text == expected
                           for tag, attrs, text in home), (lang, kind, slug)
                archive = Labels(destination / lang / route.strip('/') / 'index.html').labels
                assert any(tag == 'h1' and text == expected for tag, _, text in archive), (lang, kind, slug)
    # Article association labels use the same resolver as the sidebar and headings.
    for source in (ROOT / 'content/posts').glob('*/index.en.html'):
        frontmatter = tomllib.loads(source.read_text().split('+++')[1])
        labels = Labels(destination / 'en' / frontmatter['url'].strip('/') / 'index.html').labels
        for kind, prefix in (('categories', 'category'), ('tags', 'tag')):
            for slug in frontmatter.get(kind, []):
                expected = translations[kind].get(slug, taxonomies[kind][slug]['name'])
                assert any(tag == 'a' and attrs.get('href') == f'/{prefix}/{slug}/' and text == expected
                           for tag, attrs, text in labels), (source, kind, slug)


def check_discussions(work):
    content, data, config_dir = (work / name for name in ('discussion-content', 'discussion-data', 'empty-config'))
    for path in (content, data, config_dir):
        path.mkdir()
    source_url = 'https://blog.vpsfree.cz/shared-discussion-fixture/'
    sources = {'published': source_url, 'draft': source_url,
               'escaped': 'https://blog.vpsfree.cz/a&b/',
               'wrong-host': 'https://blog.vpsfree.cz.invalid/article/',
               'query': source_url + '?preview=1', 'fragment': source_url + '#comments',
               'port': 'https://blog.vpsfree.cz:443/article/'}
    (data / 'articles.json').write_text(json.dumps({key: {'discussion_url': value, 'author_ids': []}
                                                  for key, value in sources.items()}))
    (data / 'authors.json').write_text('{}')
    for article_id in sources:
        for lang in ('cs', 'en'):
            (content / f'{article_id}.{lang}.html').write_text('+++\ntitle = "Synthetic discussion check"\n'
                'date = "2026-01-01T12:00:00+01:00"\ntype = "posts"\n'
                f'draft = {str(article_id == "draft").lower()}\n'
                f'url = "/discussion-{article_id}-{lang}/"\n'
                f'translationKey = "discussion-{article_id}"\n[params]\narticle_id = "{article_id}"\n'
                '+++\n<p>Synthetic local check only.</p>\n')
    cases = (('production', True, False), ('production', False, False),
             ('preview', True, False), ('vpn', True, False), ('production', True, True))
    for number, (environment, enabled, wrong_origin) in enumerate(cases):
        config = tomllib.loads((ROOT / 'hugo.toml').read_text())
        config.update(contentDir=str(content), dataDir=str(data))
        config['params']['discourse']['enabled'] = enabled
        for lang, host in (('cs', 'blog.vpsfree.cz'), ('en', 'blog.vpsfree.org')):
            config['languages'][lang]['baseURL'] = f'https://{lang}.preview.invalid/' if wrong_origin else f'https://{host}/'
        config_path = work / f'discussion-{number}.json'
        config_path.write_text(json.dumps(config))
        destination = work / f'discussion-{number}'
        run('hugo', '--environment', environment, '--buildDrafts', '--configDir', str(config_dir),
            '--config', str(config_path), '--destination', str(destination), '--panicOnWarning')
        identities = []
        for article_id in sources:
            for lang in ('cs', 'en'):
                path = destination / lang / f'discussion-{article_id}-{lang}/index.html'
                text = path.read_text()
                should_embed = environment == 'production' and enabled and not wrong_origin and article_id in ('published', 'escaped')
                assert ('window.DiscourseEmbed =' in text) == should_embed, (number, article_id, lang)
                assert Page(path).has('a', href='https://discourse.vpsfree.cz/')
                if should_embed:
                    encoded = text.split('window.DiscourseEmbed = ', 1)[1]
                    payload, _ = json.JSONDecoder().raw_decode(encoded)
                    assert payload == {'discourseUrl': 'https://discourse.vpsfree.cz/',
                                       'discourseEmbedUrl': sources[article_id]}
                    if article_id == 'published':
                        identities.append(payload['discourseEmbedUrl'])
                    if article_id == 'escaped':
                        assert r'\u0026' in encoded
                    assert Page(path).has('div', id='discourse-comments')
        if identities:
            assert identities == [source_url, source_url]


with tempfile.TemporaryDirectory(prefix='blog-check-') as directory:
    work = Path(directory)
    check_join_graphic()
    check_preview_isolation(work)
    check_taxonomy_labels(work)
    check_discussions(work)
    production, repeat, drafts, fixture_production = [work / x for x in
        ('production', 'repeat', 'drafts', 'fixture-production')]
    run('bin/build', str(production))
    run('bin/build', str(repeat))
    assert digest_tree(production) == digest_tree(repeat), 'build is not deterministic'
    check_roots(production, {'cs': 'https://blog.vpsfree.cz/', 'en': 'https://blog.vpsfree.org/'})
    check_search_index(production / 'cs', {'cs-cz': 125})
    check_search_index(production / 'en', {})
    for language in ('cs', 'en'):
        page = Page(production / language / 'search/index.html')
        assert page.has('section', **{'data-search-page': None, 'data-has-articles': str(language == 'cs').lower()})
        assert page.has('form', action='/search/', method='get', role='search')
    assert not any('synthetic' in p or 'synteticky' in p for p in digest_tree(production))
    metadata = json.loads((production / 'metadata.json').read_text())
    for name, expected in metadata['files'].items():
        assert hashlib.sha256((production / name).read_bytes()).hexdigest() == expected
        assert name.startswith(('cs/', 'en/')), name
    assert not (production / 'cs/metadata.json').exists()
    assert not (production / 'en/metadata.json').exists()

    manifest_path = ROOT / 'data/migration/source-manifest.json'
    if manifest_path.exists():
        manifest = json.loads(manifest_path.read_text())
        article_data = json.loads((ROOT / 'data/articles.json').read_text())
        posts = []
        for article in manifest['articles']:
            source = ROOT / article['cs_file']
            frontmatter = tomllib.loads(source.read_text().split('+++')[1])
            path = production / 'cs' / article['cs_path'].strip('/') / 'index.html'
            page = Page(path)
            assert page.has('article', **{'data-article-id': article['article_id']})
            assert page.has('section', id='comments') and page.has('div', id='respond')
            assert page.has('span', id='more-' + str(article['legacy_post_id']))
            comments_file = ROOT / 'data/legacy-comments' / (article['article_id'] + '.json')
            for comment in json.loads(comments_file.read_text()):
                assert page.has('li', id='comment-' + str(comment['id']))
            month = frontmatter['date'][:7].replace('-', '/')
            assert (production / 'cs' / month / 'index.html').is_file()
        for author in json.loads((ROOT / 'data/authors.json').read_text()).values():
            assert (production / 'cs/author' / author['slug'] / 'index.html').is_file()
        for kind, prefix in (('categories', 'category'), ('tags', 'tag')):
            for slug in json.loads((ROOT / 'data/taxonomies.json').read_text())[kind]:
                assert (production / 'cs' / prefix / slug / 'index.html').is_file()
        for source in (ROOT / 'content/posts').glob('*/index.cs.*'):
            frontmatter = tomllib.loads(source.read_text().split('+++')[1])
            if not frontmatter.get('draft', False):
                posts.append(frontmatter)
        items = ET.parse(production / 'cs/feed/index.xml').findall('channel/item')
        expected = sorted(posts, key=lambda post: post['date'], reverse=True)[:10]
        assert len(items) == len(expected)
        for post, item in zip(expected, items):
            assert item.findtext('guid') == article_data[post['params']['article_id']]['feed_guids']['cs']
            assert item.find('guid').get('isPermaLink') == 'false'
            assert item.findtext('{http://purl.org/rss/1.0/modules/content/}encoded')


    config = 'hugo.toml,fixtures/hugo.toml'
    run('hugo', '--environment', 'production', '--config', config,
        '--destination', str(fixture_production), '--panicOnWarning')
    assert not (fixture_production / 'cs/synteticky-priklad_1').exists()
    assert not (fixture_production / 'en/synthetic-example_1').exists()

    run('hugo', '--environment', 'preview', '--buildDrafts', '--config',
        config + ',config/preview/hugo.toml', '--destination', str(drafts), '--panicOnWarning')
    run('bin/index-search', str(drafts))
    check_search_index(drafts / 'cs', {'cs-cz': 2})
    check_search_index(drafts / 'en', {'en': 1})
    check_roots(drafts, {'cs': 'http://localhost:1313/', 'en': 'http://localhost:1314/'})
    for lang, path, other_path, other_locale, other_port in [
        ('cs', 'synteticky-priklad_1', 'synthetic-example_1', 'en', 1314),
        ('en', 'synthetic-example_1', 'synteticky-priklad_1', 'cs-CZ', 1313),
    ]:
        page = Page(drafts / lang / path / 'index.html')
        assert page.has('link', rel='alternate', hreflang=other_locale,
                        href=f'http://localhost:{other_port}/{other_path}/')
        assert page.has('a', href=f'http://localhost:{other_port}/{other_path}/')
        assert page.has('article', **{'data-article-id': 'synthetic-pair'})
        assert page.has('section', id='comments', **{'data-discussion-url':
            'https://blog.vpsfree.cz/synteticky-priklad_1/'})
        assert page.has('meta', name='robots', content='noindex, nofollow')
    unpaired = drafts / 'cs/synteticky-bez-prekladu/index.html'
    assert 'Překlad zatím není k dispozici.' in unpaired.read_text()
    assert not (drafts / 'en/synteticky-bez-prekladu').exists()

    vpn = work / 'vpn'
    run('hugo', '--environment', 'vpn', '--buildDrafts', '--config', config,
        '--destination', str(vpn), '--panicOnWarning')
    run('bin/index-search', str(vpn), '--single-root')
    check_search_index(vpn, {'cs-cz': 2, 'en': 1})
    for home in ('', 'en/'):
        assert (vpn / home / 'search/index.html').is_file()
        assert Page(vpn / home / 'search/index.html').has('form', action='/' + home + 'search/', method='get', role='search')
    base = 'http://aitherdev.int.vpsfree.cz:4567/'
    fixture_urls = []
    for source in (ROOT / 'fixtures/content').rglob('*.md'):
        frontmatter = tomllib.loads(source.read_text().split('+++')[1])
        fixture_urls.append(frontmatter['url'])
    assert len(fixture_urls) == len(set(fixture_urls)), 'singlehost fixture URL collision'
    for home in ('', 'en/'):
        page = Page(vpn / home / 'index.html')
        assert page.has('link', rel='canonical', href=base + home)
        assert page.has('link', rel='alternate', type='application/rss+xml',
                        href=base + home + 'feed/')
        feed = ET.parse(vpn / home / 'feed/index.xml').getroot()
        assert feed.find('channel/{http://www.w3.org/2005/Atom}link').get('href') == base + home + 'feed/'
    for path, other in [('synteticky-priklad_1', 'synthetic-example_1'),
                        ('synthetic-example_1', 'synteticky-priklad_1')]:
        page = Page(vpn / path / 'index.html')
        assert page.has('link', rel='canonical', href=base + path + '/')
        assert page.has('a', href=base + other + '/')
    for source in vpn.rglob('*.html'):
        text = source.read_text()
        check_search_script(Page(source))
        assert '<iframe' not in text
        assert 'localhost:' not in text

    # Test default real-content selection without touching the repository corpus.
    real = work / 'real-content'
    real.mkdir()
    (real / 'temporary.cs.md').write_text('+++\ntitle = "Temporary check draft"\n'
        'date = "2026-01-01T12:00:00+01:00"\ndraft = true\n'
        'lastmod = "2026-01-01T12:00:00+01:00"\n'
        'url = "/temporary-check-draft/"\ntranslationKey = "temporary-check"\n'
        '[params]\narticle_id = "temporary-check"\n+++\n\nTemporary local check only.\n'
        '\n`https://blog.vpsfree.cz/wp-content/uploads/2014/11/foto5.jpg`\n'
        '\n![Local media](https://blog.vpsfree.cz/wp-content/uploads/2014/11/foto5.jpg)\n')
    real_output = work / 'real-preview'
    run('hugo', '--environment', 'preview', '--buildDrafts', '--contentDir', str(real),
        '--destination', str(real_output), '--panicOnWarning')
    assert (real_output / 'cs/temporary-check-draft/index.html').is_file()
    real_page = Page(real_output / 'cs/temporary-check-draft/index.html')
    assert real_page.has('img', src='/wp-content/uploads/2014/11/foto5.jpg')
    assert '<code>https://blog.vpsfree.cz/wp-content/uploads/2014/11/foto5.jpg</code>' in (real_output / 'cs/temporary-check-draft/index.html').read_text()
    assert not (real_output / 'cs/synteticky-priklad_1').exists()

    # EN legacy anchors keep their authoritative Czech destination in every mode.
    originals = {urlparse(article['discussion_url']).path: article['discussion_url']
                 for article in json.loads((ROOT / 'data/articles.json').read_text()).values()}
    legacy_path = '/setrvacnost-konferencniho-efektu/'
    other_path = '/nominujte-vpsfree-cz-do-kristalove-lupy/'
    suffix = '?source=preview&amp;literal=$value#comments'
    link_source = work / 'link-content'
    link_source.mkdir()
    body = (f'<p><a id="known" href="{legacy_path}{suffix}">known</a></p>\n'
            '<!--more-->\n'
            f"<a id='single' href='{other_path}#respond'>single quote</a>\n"
            f'<a id="bare" href={other_path}>unquoted</a>\n'
            f'<pre><a id="pre" href="{legacy_path}">pre</a></pre>\n'
            f'<code><a id="code" href="{legacy_path}">code</a></code>\n'
            f'<!-- <a href="{legacy_path}">comment</a> -->\n'
            f'<p>Literal {legacy_path}</p>\n'
            f'<a id="attribute" data-href="{legacy_path}" href="#comments">data</a>\n'
            f'<a id="absolute" href="https://blog.vpsfree.cz{legacy_path}">absolute</a>\n'
            f'<a id="protocol" href="//blog.vpsfree.cz{legacy_path}">protocol</a>\n'
            '<a id="unknown" href="/unknown-legacy-path/">unknown</a>\n'
            '<a id="media" href="/wp-content/uploads/file.pdf">media</a>\n'
            '<a id="query" href="?query=unchanged">query</a>\n'
            f'<a id="exact" href="{legacy_path.rstrip("/")}">missing slash</a>\n')
    for lang in ('cs', 'en'):
        (link_source / f'links.{lang}.html').write_text('+++\ntitle = "Link contract"\n'
            'date = "2026-01-01T12:00:00+01:00"\ndraft = false\ntype = "posts"\n'
            f'url = "/link-contract-{lang}/"\ntranslationKey = "link-contract"\n'
            '[params]\narticle_id = "wp-123"\n+++\n' + body)
    for environment in ('production', 'preview', 'vpn'):
        destination = work / ('link-' + environment)
        run('hugo', '--environment', environment, '--contentDir', str(link_source),
            '--destination', str(destination), '--panicOnWarning')
        for lang in ('cs', 'en'):
            root = destination if environment == 'vpn' else destination / lang
            page_path = root / f'link-contract-{lang}/index.html'
            text = page_path.read_text()
            page = Page(page_path)
            expected = originals[legacy_path] if lang == 'en' else legacy_path
            other = originals[other_path] if lang == 'en' else other_path
            assert f'href="{expected}{suffix}"' in text, (environment, lang,
                [attrs for tag, attrs in page.elements if attrs.get('id') == 'known'])
            assert page.has('a', id='single', href=other + '#respond')
            assert page.has('a', id='bare', href=other)
            for context in ('pre', 'code'):
                assert f'<{context}><a id="{context}" href="{legacy_path}">' in text
            assert f'<!-- <a href="{legacy_path}">comment</a> -->' in text
            assert f'<p>Literal {legacy_path}</p>' in text
            for identifier, href in (('attribute', '#comments'),
                    ('absolute', 'https://blog.vpsfree.cz' + legacy_path),
                    ('protocol', '//blog.vpsfree.cz' + legacy_path),
                    ('unknown', '/unknown-legacy-path/'),
                    ('media', '/wp-content/uploads/file.pdf'),
                    ('query', '?query=unchanged'), ('exact', legacy_path.rstrip('/'))):
                assert page.has('a', id=identifier, href=href)
            home = root / ('en/index.html' if environment == 'vpn' and lang == 'en' else 'index.html')
            assert f'href="{expected}{suffix}"' in home.read_text()
            feed_root = root / ('en' if environment == 'vpn' and lang == 'en' else '')
            feed_body = ET.parse(feed_root / 'feed/index.xml').findtext(
                'channel/item/{http://purl.org/rss/1.0/modules/content/}encoded')
            # Hugo's existing RSS serializer makes remaining relative hrefs absolute.
            origin = {'production': {'cs': 'https://blog.vpsfree.cz', 'en': 'https://blog.vpsfree.org'},
                      'preview': {'cs': 'http://localhost:1313', 'en': 'http://localhost:1314'},
                      'vpn': {'cs': base.rstrip('/'), 'en': base.rstrip('/')}}[environment][lang]
            feed_expected = expected if lang == 'en' else origin + legacy_path
            assert f'href="{feed_expected}{suffix}"' in feed_body
            assert f'<pre><a id="pre" href="{origin}{legacy_path}">' in feed_body

    # Exercise production host metadata without publishing a fixture.
    prod_hosts = work / 'fixture-hosts'
    run('hugo', '--environment', 'production', '--buildDrafts', '--config', config,
        '--destination', str(prod_hosts), '--panicOnWarning')
    for lang, path, host, other_host, other_path, other_locale in [
        ('cs', 'synteticky-priklad_1', 'blog.vpsfree.cz', 'blog.vpsfree.org', 'synthetic-example_1', 'en'),
        ('en', 'synthetic-example_1', 'blog.vpsfree.org', 'blog.vpsfree.cz', 'synteticky-priklad_1', 'cs-CZ'),
    ]:
        page = Page(prod_hosts / lang / path / 'index.html')
        assert page.has('link', rel='canonical', href=f'https://{host}/{path}/')
        assert page.has('link', rel='alternate', hreflang=other_locale,
                        href=f'https://{other_host}/{other_path}/')

if options.preview or options.vpn or options.real_vpn:
    class NoRedirect(HTTPRedirectHandler):
        def redirect_request(self, *args, **kwargs):
            return None

    opener = build_opener(NoRedirect)
    urls = [f'http://localhost:{port}/feed/' for port in (1313, 1314)] if options.preview else []
    if options.vpn or options.real_vpn:
        urls += ['http://172.16.106.40:4567/feed/', 'http://172.16.106.40:4567/en/feed/']
    for url in urls:
        with opener.open(url, timeout=5) as response:
            assert response.status == 200 and response.url == url
            assert response.headers.get('Location') is None
            assert response.headers.get_content_type() == 'application/rss+xml'
            assert ET.fromstring(response.read()).tag == 'rss'
    if options.vpn:
        advertised = 'http://aitherdev.int.vpsfree.cz:4567/'
        for path in ('', 'en/', 'synteticky-priklad_1/', 'synthetic-example_1/'):
            url = 'http://172.16.106.40:4567/' + path
            with opener.open(url, timeout=5) as response:
                assert response.status == 200 and response.headers.get('Location') is None
                text = response.read().decode()
                assert f'href="{advertised}{path}"' in text, path
                assert 'localhost:' not in text, path
                check_search_script(Page(text=text))
                assert '<iframe' not in text, path
                assert 'noindex, nofollow' in text, path
                if path.startswith(('synteticky-', 'synthetic-')):
                    assert advertised + 'synteticky-priklad_1/' in text
                    assert advertised + 'synthetic-example_1/' in text
    if options.real_vpn:
        advertised = 'http://aitherdev.int.vpsfree.cz:4567/'
        pair = {lang: tomllib.loads((ROOT / f'content/posts/wp-615/index.{lang}.html').read_text().split('+++')[1])['url']
                for lang in ('cs', 'en')}
        for path in ('/', '/en/', pair['cs'], pair['en']):
            with opener.open('http://172.16.106.40:4567' + path, timeout=5) as response:
                assert response.status == 200 and response.headers.get('Location') is None
                text = response.read().decode()
            assert f'<link rel="canonical" href="{advertised.rstrip("/")}{path}">' in text, path
            assert 'localhost:' not in text and not re.search(r'<script\b', text, re.I), path
            assert not any('discourse.vpsfree.cz' in tag for tag in re.findall(r'<iframe\b[^>]*>', text, re.I)), path
            assert 'noindex, nofollow' in text and 'id="discourse-comments"' not in text, path
            if path in pair.values():
                assert advertised.rstrip('/') + pair['cs'] in text
                assert advertised.rstrip('/') + pair['en'] in text
            if path == pair['en']:
                assert 'This English translation is awaiting human review.' in text
            if path == '/en/':
                assert '/en/category/akce/' in text and '>Events</a>' in text

print('Passed: dual-host routes, metadata, pairing, draft isolation and deterministic output')
