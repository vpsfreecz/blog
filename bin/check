                               'https://kb.vpsfree.org/manuals/vps/backups?first=a%26b&amp;second=$value#downloading_backups'),
        'kb-userns': ('https://kb.vpsfree.cz/navody/vps/vpsadminos#user_namespaces',
                      'https://kb.vpsfree.org/manuals/vps/userns#user_namespace'),
        'kb-backups': ('https://kb.vpsfree.cz/navody/vps/zalohovani',
                       'https://kb.vpsfree.org/manuals/vps/backups'),
        'kb-storage': ('https://kb.vpsfree.cz/navody/vps/vpsadminos/storage',
                       'https://kb.vpsfree.org/manuals/vps/vpsadminos/storage'),
        'kb-infrastructure': ('https://kb.vpsfree.cz/informace/infrastruktura',
                              'https://kb.vpsfree.org/information/infrastructure'),
        'kb-encoded': ('https://kb.vpsfree.cz/%6eavody/vps/api', 'https://kb.vpsfree.org/manuals/vps/api'),
        'kb-colon': ('//kb.vpsfree.cz/navody:vps:api', 'https://kb.vpsfree.org/manuals/vps/api'),
        'kb-entity': ('https://kb&#46;vpsfree&#46;cz/navody/vps/api', 'https://kb.vpsfree.org/manuals/vps/api'),
        'kb-query': ('http://kb.vpsfree.cz/navody/vps/api?source=preview&amp;value=a%26b%3Dc#prace_s_api',
                     'https://kb.vpsfree.org/manuals/vps/api?source=preview&amp;value=a%26b%3Dc#working_with_the_api'),
        'kb-cross': ('https://kb.vpsfree.cz/fixture/source?first=a%26b&amp;second=$value#old',
                     'https://kb.vpsfree.org/fixture/moved?first=a%26b&amp;second=$value#new-section'),
        'kb-cross-unknown': ('https://kb.vpsfree.cz/fixture/source#unknown',
                             'https://kb.vpsfree.cz/fixture/source#unknown'),
        'kb-cross-page': ('https://kb.vpsfree.cz/fixture/source',
                          'https://kb.vpsfree.org/fixture/original'),
    }
    for name in invalid_targets:
        source = f'https://kb.vpsfree.cz/fixture/source#{name}'
        kb_cases['kb-cross-invalid-' + name] = (source, source)
    for identifier, href in {
        'kb-unresolved-bouncer': 'https://kb.vpsfree.cz/informace/chat#bouncer',
        'kb-unresolved-openvz': 'https://kb.vpsfree.cz/informace/openvz',
        'kb-malformed': 'https://kb.vpsfree.cz/%ZZ/navody/vps/api',
        'kb-double-encoded': 'https://kb.vpsfree.cz/%256eavody/vps/api',
        'kb-port': 'https://kb.vpsfree.cz:443/navody/vps/api',
        'kb-userinfo': 'https://user@kb.vpsfree.cz/navody/vps/api',
        'kb-lookalike': 'https://kb.vpsfree.cz.invalid/navody/vps/api',
        'kb-english': 'https://kb.vpsfree.org/manuals/vps/api',
        'kb-action': 'https://kb.vpsfree.cz/navody/vps/api?do=export_xhtml',
        'kb-encoded-action': 'https://kb.vpsfree.cz/navody/vps/api?%64o=export_xhtml',
        'kb-revision': 'https://kb.vpsfree.cz/navody/vps/api?rev=123',
        'kb-legacy': 'https://kb.vpsfree.cz/doku.php?id=navody:vps:api',
        'kb-root-query': 'https://kb.vpsfree.cz/?id=navody:vps:api',
        'kb-media': 'https://kb.vpsfree.cz/navody/vps/api?media=file.pdf',
    }.items():
        kb_cases[identifier] = (href, href)
    body = (f'<p><a id="known" href="{legacy_path}{suffix}">known</a></p>\n'
            '<!--more-->\n'
            f"<a id='single' href='{other_path}#respond'>single quote</a>\n"
            f'<a id="bare" href={absent_path}>unquoted absent target</a>\n'
            f'<a id="more" href="{legacy_path}#more-82">more</a>\n'
            f'<a id="comment" href="{legacy_path}#comment-24">comment</a>\n'
            f'<a id="unknown-section" href="{legacy_path}#unverified-heading">unknown section</a>\n'
            f'<pre><a id="pre" href="{legacy_path}">pre</a></pre>\n'
            f'<code><a id="code" href="{legacy_path}">code</a></code>\n'
            f'<!-- <a href="{legacy_path}">comment</a> -->\n'
            f'<script>const example = \'<a href="{legacy_path}">\';</script>\n'
            f'<p>Literal {legacy_path}</p>\n'
            f'<a id="attribute" data-href="{legacy_path}" href="#comments">data</a>\n'
            f'<a id="attribute-string" title=\'example href="{legacy_path}"\' href="{legacy_path}">attribute string</a>\n'
            f'<a id="absolute" href="http://blog.vpsfree.cz{legacy_path}">absolute</a>\n'
            f'<a id="protocol" href="//blog.vpsfree.cz{legacy_path}">protocol</a>\n'
            '<a id="unknown" href="/unknown-legacy-path/">unknown</a>\n'
            '<a id="media" href="/wp-content/uploads/file.pdf">media</a>\n'
            '<a id="query" href="?query=unchanged">query</a>\n'
            f'<a id="exact" href="{legacy_path.rstrip("/")}">missing slash</a>\n'
            f'<a id="legacy-id" href="https://blog.vpsfree.cz/?p=82">legacy query</a>\n'
            f'<a id="blog-action" href="https://blog.vpsfree.cz{legacy_path}?do=edit">action</a>\n'
            '<a id="external" href="https://vpsadmin.vpsfree.cz/?x=1&amp;y=2">external</a>\n'
            '<a id="mail" href="mailto:podpora@vpsfree.cz">mail</a>\n'
            '<a id="taxonomy" href="https://blog.vpsfree.cz/tag/vpsadminos/">taxonomy</a>\n')
    body += ''.join(f'<a id="{name}" href="{href}">KB</a>\n' for name, (href, _) in kb_cases.items())
    for lang in ('cs', 'en'):
        (link_source / f'links.{lang}.html').write_text('+++\ntitle = "Link contract"\n'
            'date = "2026-01-01T12:00:00+01:00"\ndraft = false\ntype = "posts"\n'
            f'url = "/link-contract-{lang}/"\ntranslationKey = "link-contract"\n'
            '[params]\narticle_id = "wp-123"\n+++\n' + body)
    for aid, route, draft in [('wp-82', '/actual-rendered-english-route/', False),
                              ('wp-107', '/actual-draft-english-route/', True)]:
        (link_source / f'{aid}.en.html').write_text('+++\ntitle = "Destination"\n'
            'date = "2020-01-01T12:00:00+01:00"\ntype = "posts"\n'
            f'draft = {str(draft).lower()}\nurl = "{route}"\ntranslationKey = "{aid}"\n'
            f'[params]\narticle_id = "{aid}"\n+++\n<span id="more-{aid[3:]}"></span>Destination')
    for environment in ('production', 'preview', 'vpn'):
        destination = work / ('link-' + environment)
        flags = [] if environment == 'production' else ['--buildDrafts']
        run('hugo', '--environment', environment, *flags, '--contentDir', str(link_source),
            '--config', f'hugo.toml,{link_config}', '--destination', str(destination), '--panicOnWarning')
        for lang in ('cs', 'en'):
            root = destination if environment == 'vpn' else destination / lang
            page_path = root / f'link-contract-{lang}/index.html'
            text = page_path.read_text()
            page = Page(page_path)
            origin = {'production': {'cs': 'https://blog.vpsfree.cz', 'en': 'https://blog.vpsfree.org'},
                      'preview': {'cs': 'http://localhost:1313', 'en': 'http://localhost:1314'},
                      'vpn': {'cs': base.rstrip('/'), 'en': base.rstrip('/')}}[environment][lang]
            expected = origin + '/actual-rendered-english-route/' if lang == 'en' else legacy_path
            other = (origin + '/actual-draft-english-route/' if environment != 'production'
                     else originals[other_path]) if lang == 'en' else other_path
            assert f'href="{expected}{suffix}"' in text
            assert f"id='single' href='{other}#respond'" in text
            absent = originals[absent_path] if lang == 'en' else absent_path
            assert f'id="bare" href={absent}' in text
            for fragment in ('more-82', 'comment-24'):
                assert page.has('a', href=expected + '#' + fragment)
            fallback = originals[legacy_path] if lang == 'en' else legacy_path
            assert page.has('a', id='unknown-section', href=fallback + '#unverified-heading')
            for context in ('pre', 'code'):
                assert f'<{context}><a id="{context}" href="{legacy_path}">' in text
            assert f'<!-- <a href="{legacy_path}">comment</a> -->' in text
            assert f'<script>const example = \'<a href="{legacy_path}">\';</script>' in text
            assert f'<p>Literal {legacy_path}</p>' in text
            assert f'data-href="{legacy_path}"' in text
            assert f'title=\'example href="{legacy_path}"\' href="{expected}"' in text
            for identifier, href in (('attribute', '#comments'),
                    ('absolute', expected if lang == 'en' else 'http://blog.vpsfree.cz' + legacy_path),
                    ('protocol', expected if lang == 'en' else '//blog.vpsfree.cz' + legacy_path),
                    ('unknown', '/unknown-legacy-path/'), ('media', '/wp-content/uploads/file.pdf'),
                    ('query', '?query=unchanged'), ('exact', legacy_path.rstrip('/')),
                    ('legacy-id', 'https://blog.vpsfree.cz/?p=82'),
                    ('blog-action', 'https://blog.vpsfree.cz' + legacy_path + '?do=edit'),
                    ('external', 'https://vpsadmin.vpsfree.cz/?x=1&y=2'),
                    ('mail', 'mailto:podpora@vpsfree.cz'), ('taxonomy', 'https://blog.vpsfree.cz/tag/vpsadminos/')):
                assert page.has('a', id=identifier, href=href), (environment, lang, identifier, href)
            for name, (original, translated) in kb_cases.items():
                href = translated if lang == 'en' else original
                assert f'id="{name}" href="{href}"' in text, (environment, lang, name)
            assert '&amp;amp;' not in text
            home = root / ('en/index.html' if environment == 'vpn' and lang == 'en' else 'index.html')
            assert f'href="{expected}{suffix}"' in home.read_text()
            feed_root = root / ('en' if environment == 'vpn' and lang == 'en' else '')
            feed_body = ET.parse(feed_root / 'feed/index.xml').findtext(
                'channel/item/{http://purl.org/rss/1.0/modules/content/}encoded')
            feed_expected = expected if lang == 'en' else origin + legacy_path
            assert f'href="{feed_expected}{suffix}"' in feed_body
            assert f'<pre><a id="pre" href="{origin}{legacy_path}">' in feed_body
            assert 'https://kb.vpsfree.org/manuals/vps/api' in feed_body if lang == 'en' else True

    # All real draft destinations must exist in the single-port topology too.
    real_vpn = work / 'real-link-vpn'
    run('hugo', '--environment', 'vpn', '--buildDrafts', '--buildFuture', '--destination', str(real_vpn), '--panicOnWarning')
    check_real_english_links(real_vpn, 'vpn')

    # Exercise production host metadata without publishing a fixture.
    prod_hosts = work / 'fixture-hosts'
    run('hugo', '--environment', 'production', '--buildDrafts', '--config', config,
        '--destination', str(prod_hosts), '--panicOnWarning')
    for lang, path, host, other_host, other_path, other_locale in [
        ('cs', 'synteticky-priklad_1', 'blog.vpsfree.cz', 'blog.vpsfree.org', 'synthetic-example_1', 'en'),
        ('en', 'synthetic-example_1', 'blog.vpsfree.org', 'blog.vpsfree.cz', 'synteticky-priklad_1', 'cs-CZ'),
    ]:
        page = Page(prod_hosts / lang / path / 'index.html')
        assert page.has('link', rel='canonical', href=f'https://{host}/{path}/')
        assert page.has('link', rel='alternate', hreflang=other_locale,
                        href=f'https://{other_host}/{other_path}/')

if options.preview or options.vpn or options.real_vpn:
    class NoRedirect(HTTPRedirectHandler):
        def redirect_request(self, *args, **kwargs):
            return None

    opener = build_opener(NoRedirect)
    urls = [f'http://localhost:{port}/feed/' for port in (1313, 1314)] if options.preview else []
    if options.vpn or options.real_vpn:
        urls += ['http://172.16.106.40:4567/feed/', 'http://172.16.106.40:4567/en/feed/']
    for url in urls:
        with opener.open(url, timeout=5) as response:
            assert response.status == 200 and response.url == url
            assert response.headers.get('Location') is None
            assert response.headers.get_content_type() == 'application/rss+xml'
            assert ET.fromstring(response.read()).tag == 'rss'
    if options.vpn:
        advertised = 'http://aitherdev.int.vpsfree.cz:4567/'
        for path in ('', 'en/', 'synteticky-priklad_1/', 'synthetic-example_1/'):
            url = 'http://172.16.106.40:4567/' + path
            with opener.open(url, timeout=5) as response:
                assert response.status == 200 and response.headers.get('Location') is None
                text = response.read().decode()
                assert f'href="{advertised}{path}"' in text, path
                assert 'localhost:' not in text, path
                check_search_script(Page(text=text))
                assert '<iframe' not in text, path
                assert 'noindex, nofollow' in text, path
                if path.startswith(('synteticky-', 'synthetic-')):
                    assert advertised + 'synteticky-priklad_1/' in text
                    assert advertised + 'synthetic-example_1/' in text
    if options.real_vpn:
        advertised = 'http://aitherdev.int.vpsfree.cz:4567/'
        pair = {lang: tomllib.loads(ARTICLE_SOURCES['wp-615'][lang].read_bytes().decode().split('+++')[1])['url']
                for lang in ('cs', 'en')}
        for path in ('/', '/en/', pair['cs'], pair['en']):
            with opener.open('http://172.16.106.40:4567' + path, timeout=5) as response:
                assert response.status == 200 and response.headers.get('Location') is None
                text = response.read().decode()
            assert f'<link rel="canonical" href="{advertised.rstrip("/")}{path}">' in text, path
            assert 'localhost:' not in text and not re.search(r'<script\b', text, re.I), path
            assert not any('discourse.vpsfree.cz' in tag for tag in re.findall(r'<iframe\b[^>]*>', text, re.I)), path
            assert 'noindex, nofollow' in text and 'id="discourse-comments"' not in text, path
            if path in pair.values():
                assert advertised.rstrip('/') + pair['cs'] in text
                assert advertised.rstrip('/') + pair['en'] in text
            if path == pair['en']:
                assert 'This English translation is awaiting human review.' not in text
            if path == '/en/':
                assert '/en/category/akce/' in text and '>Events</a>' in text

print('Passed: dual-host routes, metadata, pairing, draft isolation and deterministic output')
