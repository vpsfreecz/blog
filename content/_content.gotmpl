{{/* Native archive pages only; article source and metadata remain importer/author-owned. */}}
{{ .EnableAllLanguages }}
{{ range $id, $author := hugo.Data.authors }}
  {{ with $author.slug }}{{ $.AddPage (dict "kind" "section" "path" (printf "author/%s" .) "title" $author.name "layout" "archive" "params" (dict "archive_author" $id)) }}{{ end }}
{{ end }}
{{/* Read only public article front matter; built Site.Pages are unavailable in adapters. */}}
{{ $months := slice }}
{{ $lang := .Site.Language.Lang }}
{{ if os.FileExists "content/posts" }}
  {{ range os.ReadDir "content/posts" }}
    {{ if .IsDir }}
      {{ $directory := printf "content/posts/%s" .Name }}
      {{ range os.ReadDir $directory }}
        {{ if hasPrefix .Name (printf "index.%s." $lang) }}
          {{ $source := os.ReadFile (printf "%s/%s" $directory .Name) }}
          {{ $front := findRE `(?s)^\+\+\+\s*\n.*?\n\+\+\+` $source 1 }}
          {{ with $front }}
            {{ $metadata := transform.Unmarshal (dict "format" "toml") (replaceRE `(?s)^\+\+\+\s*\n|\n\+\+\+$` "" (index . 0)) }}
            {{ if or (ne hugo.Environment "production") (not $metadata.draft) }}
              {{ $months = $months | append ((time.AsTime $metadata.date).Format "2006/01") }}
            {{ end }}
          {{ end }}
        {{ end }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}
{{ range $months | uniq }}
  {{ $.AddPage (dict "kind" "section" "path" . "title" . "layout" "archive" "params" (dict "archive_month" .)) }}
{{ end }}
