{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{ range .Pages }}
  {{ $eligible := ne (partial "article-state.html" .) "unlisted" }}
  {{ if eq .Kind "term" }}{{ $eligible = gt (len (partial "discoverable.html" .RegularPages)) 0 }}{{ end }}
  {{ if $eligible }}
  <url><loc>{{ .Permalink }}</loc>{{ with .Lastmod }}<lastmod>{{ .Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{ end }}
    {{ range .AllTranslations }}{{ if ne (partial "article-state.html" .) "unlisted" }}<xhtml:link rel="alternate" hreflang="{{ .Language.Locale }}" href="{{ .Permalink }}"/>{{ end }}{{ end }}
  </url>
  {{ end }}
{{ end }}
</urlset>
