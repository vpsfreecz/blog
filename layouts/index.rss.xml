{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/"><channel>
<title>{{ .Site.Title }}</title><link>{{ .Site.Home.Permalink }}</link>
<atom:link href="{{ .Site.Home.Permalink }}feed/" rel="self" type="application/rss+xml"/>
<description>{{ .Site.Title }}</description><language>{{ .Site.Language.Locale }}</language>
{{ range first 10 (where .Site.RegularPages "Type" "posts").ByDate.Reverse }}
{{ $guid := "" }}{{ with index hugo.Data.articles .Params.article_id }}{{ with .feed_guids }}{{ $guid = index . $.Language.Lang }}{{ end }}{{ end }}
{{ $body := partial "article-html.html" (dict "page" . "html" .Content "absolute" true) }}
{{ if $guid }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid isPermaLink="false">{{ $guid }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ $body | htmlEscape | safeHTML }}</description><content:encoded>{{ $body | htmlEscape | safeHTML }}</content:encoded></item>{{ end }}
{{ end }}
</channel></rss>
